# App
APP_NAME=Synas Labs Text Agent
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1

# Database (Railway provides DATABASE_URL / DATABASE_URL_SYNC in production)
DATABASE_URL=postgresql+asyncpg://synas:synas@localhost:5432/synas_text_agent
DATABASE_URL_SYNC=postgresql://synas:synas@localhost:5432/synas_text_agent

# Auth (shared pattern with voice agent; used by future dashboard)
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI (chat completions for text agent — not Realtime voice)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Twilio messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# Public HTTPS base used for signature validation, e.g. https://your-service.up.railway.app
TWILIO_WEBHOOK_BASE_URL=

# Default tenant slug used when webhooks are not tenant-scoped
DEFAULT_TENANT_SLUG=synas

# CORS
CORS_ORIGINS=http://localhost:3000

# Message limits
MAX_INBOUND_MESSAGE_CHARS=4000
